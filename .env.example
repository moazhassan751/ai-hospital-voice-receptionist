# Front desk phone number for emergency transfers (E.164 format)
FRONT_DESK_NUMBER=+1234567890

# Hospital timezone for time-of-day greetings and slot calculation
TIMEZONE=Asia/Karachi

# Webhook secret to authenticate requests from Vapi/Retell
WEBHOOK_SECRET=hospital_secret_123

# Public Base URL for webhook endpoints (e.g. ngrok tunnel https://xxxx.ngrok-free.app)
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Backend Execution Mode: 'local' (uses appointments.json/data.json) or 'mock' (forwards to MOCK_URL)
BACKEND_MODE=local

# URL of mock server when BACKEND_MODE=mock (Mockoon: http://localhost:3001, Beeceptor: https://your-clinic.free.beeceptor.com, Mockbin)
MOCK_URL=http://localhost:3001

# Public Webhook Tunnel: Use ngrok ('ngrok http 3000') to expose port 3000.
# Note: ngrok CLI manages tokens via 'ngrok config add-authtoken <TOKEN>'; no env variable required.
# NGROK_AUTHTOKEN=

# Deployment Mode: 'single_hospital' or 'marketplace'
DEPLOYMENT_MODE=single_hospital

# Call Mode: 'auto', 'normal', 'after_hours', 'overflow', 'marketplace' (Default: auto)
CALL_MODE=auto

# ==============================================================================
# TELEPHONY CONFIGURATION (setup_telephony.py)
# ==============================================================================
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=

# Scenario 3: Cloud PBX / SIP Trunk Credentials (3CX, FreePBX, Asterisk)
SIP_GATEWAY_IP=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_EXTENSION=101

# Scenario 4: BYOC Credentials (Twilio, Telnyx, Plivo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional BYOC Alternatives: Telnyx / Plivo
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# ==============================================================================
# STEDI INSURANCE VERIFICATION (TEST MODE ONLY)
# ==============================================================================
# Test API key from Stedi portal (e.g. test_xxxxxxxx). Never use a production key.
STEDI_TEST_API_KEY=
